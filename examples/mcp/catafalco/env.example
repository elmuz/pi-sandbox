# Secrets for the catafalco MCP container.
#
# This file is mounted read-only at /etc/server-mcp/.env and loaded by the
# server. Keep it mode 0600. It is intentionally empty until you add a token.
#
# Generate a token, for example:
#   openssl rand -hex 32
#
# MCP_HTTP_TOKEN=replace-with-a-long-random-token
#
# Optional metric credentials:
# INFLUXDB_TOKEN=...
# PROMETHEUS_TOKEN=...

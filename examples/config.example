# Configuration for the pi-sandbox launcher.
#
# This file is sourced by bin/pi-sandbox before defaults are applied. Keep
# values unquoted when they are simple words or paths.
#
# Host workspace exposure. The default is none: Pi runs in an empty
# disposable /workspace and cannot read or modify the host checkout.
#   none       no host workspace (most secure)
#   ro         read-only mount; protects integrity, not confidentiality
#   ephemeral  copy the checkout into $PI_SANDBOX_STATE/workspaces and mount
#              the copy read-write; the host checkout is never modified
#   rw         read-write host mount; shared-checkout mode, so files written by
#              the agent can be executed later by host git, test, build, deploy
#              or IDE tools
# PI_SANDBOX_WORKSPACE_MODE=ephemeral
#
# Park an ephemeral copy on exit (default) or remove it. A parked copy is
# untrusted agent output; review it before executing anything inside it.
# PI_SANDBOX_WORKSPACE_DISCARD=0
#
# Silence the startup capability summary and the workspace secret warning.
# PI_SANDBOX_WARN=0
#
# Capabilities that are off by default. Enable only what you need.
# Wayland clipboard access lets Pi read clipboard images (and clipboard data).
# PI_SANDBOX_CLIPBOARD=1
# GitHub CLI token from $PI_SANDBOX_STATE/secrets/gh_token.
# PI_SANDBOX_GH_TOKEN=1
#
# GPG signing is opt-in. Set to 1 to forward the host gpg-agent extra socket.
# PI_SANDBOX_GPG_SIGN=1
#
# Resource limits. The defaults are intentionally modest for an agent harness.
# PI_SANDBOX_CPUS=2
# PI_SANDBOX_NOFILE=8192
#
# Egress policy file. The default lives next to this file.
# PI_SANDBOX_EGRESS_POLICY=$HOME/.config/pi-sandbox/egress-policy.conf
#
# Proxy-aware tools use these variables inside the sandbox. Add internal MCP
# hostnames here if your project uses names other than mcp-remote/mcp-disk.
# PI_SANDBOX_NO_PROXY=localhost,127.0.0.1,::1,pi-control,mcp-remote,mcp-disk

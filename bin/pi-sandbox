#!/usr/bin/env bash
#
# Launch an interactive Pi coding-agent container with:
#   - no host workspace mount by default; opt in with --workspace-mode
#   - read-only global Pi config
#   - per-project state and session storage
#   - shared provider/MCP credentials
#   - no Podman/Docker socket, no host home, no host namespaces
#
# Usage:
#   cd /path/to/project
#   pi-sandbox [pi arguments...]
#   pi-sandbox --workspace /path/to/project [pi arguments...]
#   pi-sandbox --workspace-mode none|ro|rw|ephemeral [pi arguments...]
#   pi-sandbox --workspace-discard
#   pi-sandbox --dry-run
#   pi-sandbox --mcp
#   pi-sandbox --mcp-token-file PATH
#   pi-sandbox --no-mcp
#   pi-sandbox --update
#   pi-sandbox --gpg-sign
#   pi-sandbox --clipboard | --no-clipboard
#   pi-sandbox --gh-token | --no-gh-token
#   pi-sandbox --start-egress
#   pi-sandbox --stop-egress
#   pi-sandbox --egress-status
#   pi-sandbox --help
#
# The sandbox has no direct internet route. A shared egress proxy container is
# the only member with a public network; the sandbox joins the internal
# pi-egress network and uses HTTP(S)_PROXY. The proxy denies all destinations by
# default, including public ones; the host-owned policy must explicitly allow
# the model provider and any package or git endpoints.
#
# The host workspace is not mounted by default. PI_SANDBOX_WORKSPACE_MODE
# accepts none (default), ro, rw or ephemeral; --workspace-mode overrides it
# for one launch. With none, /workspace is an empty writable tmpfs. With ro/rw
# the project is mounted at /workspace and, under $HOME, mirrored at its host
# path. With ephemeral the project is copied into the launcher state directory
# and the copy is mounted read-write, so the host checkout is never modified.
# The copy is parked by default and its path is printed on exit; pass
# --workspace-discard to remove it instead.
#
# Starting in $HOME or / uses a temporary empty workspace instead of mounting
# that directory. Scratch workspaces are always disposable and mounted
# read-write. The temporary directory is removed when the container exits.
# Its Pi state and sessions use the stable name "scratch".
#
# Wayland clipboard access and the GitHub CLI token are opt-in capabilities,
# disabled by default. Enable them with PI_SANDBOX_CLIPBOARD=1 and
# PI_SANDBOX_GH_TOKEN=1 or the matching command-line flags.
#
# MCP is a host-controlled capability. It is disabled by default and requires
# both a host opt-in (--mcp or PI_SANDBOX_MCP=1 in the trusted launcher config)
# and a project config (.pi/mcp.json or the sandbox-specific
# .pi/mcp.sandbox.json). The latter is staged in a launcher-owned temporary
# directory and mounted over .pi/mcp.json inside the container, so a
# repository-controlled symlink is never a mount source. The shared MCP bearer
# token is read from $PI_SANDBOX_STATE/secrets/mcp_token when that file exists,
# validated against the server-mcp token rules, and passed to the container as
# MCP_TOKEN through the environment. The token value never appears in the podman
# argv or in --dry-run output. --no-mcp wins over every opt-in.
#
# Source assets live in this repository. Writable runtime state lives in
# ${XDG_DATA_HOME:-$HOME/.local/share}/pi-sandbox by default.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
IMAGE_DIR="$REPO_DIR/image"
CONFIG_DIR="${PI_SANDBOX_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pi-sandbox}"
CONFIG_FILE="$CONFIG_DIR/config"

# Optional host-owned launcher configuration. It is sourced before defaults,
# so environment variables and command-line flags can still override it.
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

STATE_DIR="${PI_SANDBOX_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/pi-sandbox}"
MCP_NETWORK="${PI_SANDBOX_MCP_NETWORK:-pi-control}"
MCP_TOKEN_FILE="${PI_SANDBOX_MCP_TOKEN_FILE:-$STATE_DIR/secrets/mcp_token}"
MCP_PROJECT_CONFIG=".pi/mcp.json"
MCP_SANDBOX_CONFIG=".pi/mcp.sandbox.json"
MCP_TOKEN_VALUE=""
MCP_TOKEN_AVAILABLE=0
MCP_OPT_IN="${PI_SANDBOX_MCP:-0}"
EGRESS_NETWORK="${PI_SANDBOX_EGRESS_NETWORK:-pi-egress}"
EGRESS_UPLINK="${PI_SANDBOX_EGRESS_UPLINK:-pi-egress-uplink}"
EGRESS_PROXY_NAME="${PI_SANDBOX_EGRESS_PROXY_NAME:-pi-egress-proxy}"
EGRESS_POLICY="${PI_SANDBOX_EGRESS_POLICY:-$CONFIG_DIR/egress-policy.conf}"
EGRESS_PROXY_BASE_IMAGE="${PI_EGRESS_PROXY_BASE_IMAGE:-python:3.12-slim}"
NO_PROXY_DEFAULT="localhost,127.0.0.1,::1,$MCP_NETWORK,mcp-remote,mcp-disk"
NO_PROXY_VALUE="${PI_SANDBOX_NO_PROXY:-$NO_PROXY_DEFAULT}"
GPG_SIGN="${PI_SANDBOX_GPG_SIGN:-0}"
CPUS="${PI_SANDBOX_CPUS:-2}"
NOFILE="${PI_SANDBOX_NOFILE:-8192}"
SECRET_SCAN="${PI_SANDBOX_SECRET_SCAN:-1}"
CLIPBOARD="${PI_SANDBOX_CLIPBOARD:-0}"
GH_TOKEN_ENABLED="${PI_SANDBOX_GH_TOKEN:-0}"
WORKSPACE_DISCARD="${PI_SANDBOX_WORKSPACE_DISCARD:-0}"

# Identity of this launcher process. Container names already embed $$; the
# start time disambiguates a recycled PID when sweeping stale containers.
launcher_pid="$$"
launcher_start="$(awk '{print $22}' "/proc/$launcher_pid/stat" 2>/dev/null || true)"
container_name=""
container_started=0
podman_pid=""
mcp_stage_dir=""
clipboard_mounted=0
github_enabled=0
gpg_forwarded=0

# Match the server-mcp token-file rule: regular, non-empty, one line, and
# readable by the owner only. The value is kept in a variable, never in argv.
validate_mcp_token_file() {
  local file="$1"
  local mode=""
  local -a token_lines=()

  if [[ ! -f "$file" ]]; then
    echo "MCP token file is not a regular file: $file" >&2
    return 1
  fi

  mode="$(stat -Lc '%a' "$file" 2>/dev/null || true)"
  case "$mode" in
    400|600|0400|0600) ;;
    *)
      echo "MCP token file must be mode 0600 or 0400 without group/other access (found ${mode:-unknown}): $file" >&2
      return 1
      ;;
  esac

  if ! mapfile -t token_lines < "$file"; then
    echo "MCP token file is not readable: $file" >&2
    return 1
  fi

  if [[ "${#token_lines[@]}" -eq 0 || -z "${token_lines[0]:-}" ]]; then
    echo "MCP token file is empty: $file" >&2
    return 1
  fi

  if [[ "${#token_lines[@]}" -ne 1 ]]; then
    echo "MCP token file must contain a single line: $file" >&2
    return 1
  fi

  MCP_TOKEN_VALUE="${token_lines[0]}"
}

import_mcp_token() {
  local source="$1"
  local source_real=""
  local destination_real=""

  validate_mcp_token_file "$source" || exit 2

  source_real="$(realpath "$source")"
  destination_real="$(realpath -m "$MCP_TOKEN_FILE")"

  if [[ "$source_real" != "$destination_real" ]]; then
    install -d -m 700 "$(dirname "$MCP_TOKEN_FILE")"
    install -m 600 "$source" "$MCP_TOKEN_FILE"
  fi
}

# Resolve a project-controlled MCP config without following it out of the
# workspace. The workspace is already canonical here. A symlink that stays
# inside the workspace is allowed; one that escapes is refused before podman
# runs. The error names the path, never the contents.
resolve_mcp_config() {
  local candidate="$1"
  local resolved=""

  if [[ ! -e "$candidate" ]]; then
    return 1
  fi
  resolved="$(realpath -e -- "$candidate" 2>/dev/null || true)"
  if [[ -z "$resolved" ]]; then
    echo "MCP config cannot be resolved: $candidate" >&2
    return 2
  fi
  if [[ ! -f "$resolved" ]]; then
    echo "MCP config is not a regular file: $candidate" >&2
    return 2
  fi
  if [[ "${resolved#"$workspace"/}" == "$resolved" ]]; then
    echo "Refusing MCP config outside the workspace: $candidate -> $resolved" >&2
    return 2
  fi
  printf '%s\n' "$resolved"
}

# Stage the sandbox overlay in a launcher-owned directory. The mount source is
# then a file the repository cannot replace with a symlink between validation
# and podman run.
stage_mcp_config() {
  local source="$1"

  mcp_stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/pi-sandbox-mcp.XXXXXX")"
  chmod 700 "$mcp_stage_dir"
  install -m 600 "$source" "$mcp_stage_dir/mcp.json"
  printf '%s\n' "$mcp_stage_dir/mcp.json"
}

ensure_egress_policy() {
  if [[ -f "$EGRESS_POLICY" ]]; then
    return
  fi

  install -d -m 700 "$(dirname "$EGRESS_POLICY")"
  (
    umask 077
    cat > "$EGRESS_POLICY" <<'EOF'
# pi-sandbox egress policy.
#
# The sandbox has no direct internet or LAN route. The default is to deny every
# destination, including public ones. Add narrow allow rules for exactly what
# the agent needs.
#
#   default deny                      # default when omitted
#   default allow                     # legacy public-by-default (not recommended)
#   allow <hostname|IP|CIDR> [port]   # permit a destination
#   deny  <hostname|IP|CIDR> [port]   # block a destination
#
# Hostname rules also match subdomains. Explicit deny wins over explicit allow.
# Pi needs its model provider; add only the endpoint you use, for example:
#   allow openrouter.ai 443
#   allow api.openai.com 443
#   allow api.anthropic.com 443
#
# Package managers and git hosts need explicit rules too:
#   allow registry.npmjs.org 443
#   allow pypi.org 443
#   allow files.pythonhosted.org 443
#   allow github.com 443
#   allow codeload.github.com 443
#
# For a self-hosted LAN resource, add a narrow allow entry:
#   allow 192.168.1.50
#   allow 192.168.1.0/24 443
#
# If you use `default allow`, deny targets the sandbox must not reach directly:
#   deny mcp.example.com
#   deny 203.0.113.10

default deny
EOF
  )
  chmod 600 "$EGRESS_POLICY"
}

ensure_internal_network() {
  local name="$1"
  local internal=""

  if podman network exists "$name" >/dev/null 2>&1; then
    internal="$(podman network inspect --format '{{.Internal}}' "$name" 2>/dev/null || true)"
    if [[ "$internal" == "true" ]]; then
      return
    fi

    echo "Egress network $name exists but is not internal." >&2
    echo "Stop the containers attached to it, then remove it once:" >&2
    echo "  podman ps -a --filter network=$name" >&2
    echo "  podman network rm $name" >&2
    echo "The next launch recreates it with --internal." >&2
    return 1
  fi

  podman network create --internal "$name" >/dev/null
}

ensure_egress_networks() {
  ensure_internal_network "$EGRESS_NETWORK"
  if ! podman network exists "$EGRESS_UPLINK" >/dev/null 2>&1; then
    podman network create "$EGRESS_UPLINK" >/dev/null
  fi
}

ensure_egress_image() {
  if podman image exists "$EGRESS_PROXY_IMAGE" >/dev/null 2>&1; then
    return
  fi

  echo "Building egress proxy image $EGRESS_PROXY_IMAGE from $EGRESS_PROXY_BASE_IMAGE ..."
  podman build \
    --build-arg "BASE_IMAGE=${EGRESS_PROXY_BASE_IMAGE}" \
    -t "$EGRESS_PROXY_IMAGE" \
    -f "$IMAGE_DIR/egress-proxy.Dockerfile" \
    "$IMAGE_DIR"
}

ensure_egress_proxy() {
  ensure_egress_policy

  if [[ "$restart_egress" -eq 1 ]]; then
    podman rm -f "$EGRESS_PROXY_NAME" >/dev/null 2>&1 || true
  fi

  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    if [[ "$(podman container inspect --format '{{.State.Running}}' "$EGRESS_PROXY_NAME" 2>/dev/null || true)" != "true" ]]; then
      podman start "$EGRESS_PROXY_NAME" >/dev/null
    fi
    return
  fi

  podman run -d --rm \
    --name "$EGRESS_PROXY_NAME" \
    --hostname "$EGRESS_PROXY_NAME" \
    --label "pi-sandbox.egress-proxy=1" \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --pids-limit=128 \
    --memory=256m \
    --cpus=1 \
    --network "$EGRESS_NETWORK" \
    --network "$EGRESS_UPLINK" \
    --tmpfs "/tmp:rw,nosuid,nodev,size=16m" \
    --mount "type=bind,src=$EGRESS_POLICY,dst=/etc/pi-egress/policy.conf,ro" \
    --env "PYTHONUNBUFFERED=1" \
    "$EGRESS_PROXY_IMAGE" >/dev/null
}

ensure_egress() {
  ensure_egress_networks
  ensure_egress_image
  ensure_egress_proxy
}

print_egress_status() {
  local internal="unknown"
  local running="no"
  local image="missing"

  if podman network exists "$EGRESS_NETWORK" >/dev/null 2>&1; then
    internal="$(podman network inspect --format '{{.Internal}}' "$EGRESS_NETWORK" 2>/dev/null || true)"
  fi
  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    running="$(podman container inspect --format '{{.State.Running}}' "$EGRESS_PROXY_NAME" 2>/dev/null || echo unknown)"
  fi
  if podman image exists "$EGRESS_PROXY_IMAGE" >/dev/null 2>&1; then
    image="present"
  fi

  printf 'egress network: %s (internal=%s)\n' "$EGRESS_NETWORK" "${internal:-unknown}"
  printf 'egress uplink:  %s\n' "$EGRESS_UPLINK"
  printf 'proxy image:    %s (%s)\n' "$EGRESS_PROXY_IMAGE" "$image"
  printf 'proxy container: %s (running=%s)\n' "$EGRESS_PROXY_NAME" "$running"
  printf 'policy:         %s\n' "$EGRESS_POLICY"
  printf 'no_proxy:       %s\n' "$NO_PROXY_VALUE"
}

# Detached supervisor for the case where the launcher is killed without a
# chance to run its traps (for example SIGKILL or a terminal emulator that does
# not forward the hangup). It lives in its own session, so closing the terminal
# does not affect it. It polls the launcher identity, then removes the
# container and the scratch workspace.
start_cleanup_watchdog() {
  local script=""

  command -v setsid >/dev/null 2>&1 || return 0

  script="$(cat <<'WATCHDOG'
launcher_pid="$1"
launcher_start="$2"
container_name="$3"
scratch_dir="$4"
ephemeral_dir="$5"
workspace_discard="$6"
mcp_stage_dir="$7"

while kill -0 "$launcher_pid" 2>/dev/null; do
  current="$(awk '{print $22}' "/proc/$launcher_pid/stat" 2>/dev/null || true)"
  [[ "$current" == "$launcher_start" ]] || break
  sleep 1
done

# A podman client that outlives the launcher may still be creating the
# container, so retry instead of racing it with a single remove. Only touch a
# container whose launcher-start label belongs to this launcher: the name could
# be reused by a later process that received the same PID.
sleep 1
for _ in 1 2 3; do
  current_start="$(podman container inspect \
    --format '{{index .Config.Labels "pi-sandbox.launcher-start"}}' \
    "$container_name" 2>/dev/null || true)"

  if [[ -n "$current_start" && "$current_start" != "$launcher_start" ]]; then
    break
  fi

  if [[ "$current_start" == "$launcher_start" ]]; then
    podman rm -f --ignore "$container_name" >/dev/null 2>&1 || true
  fi

  sleep 1
done

[[ -n "$scratch_dir" ]] && rm -rf -- "$scratch_dir"
if [[ -n "$ephemeral_dir" && "$workspace_discard" == "1" ]]; then
  rm -rf -- "$ephemeral_dir"
fi
[[ -n "$mcp_stage_dir" ]] && rm -rf -- "$mcp_stage_dir"
WATCHDOG
)"

  (
    unset GH_TOKEN MCP_TOKEN
    exec setsid bash -c "$script" pi-sandbox-watchdog \
      "$launcher_pid" "$launcher_start" "$container_name" \
      "$scratch_workspace_dir" "$ephemeral_workspace_dir" "$WORKSPACE_DISCARD" \
      "$mcp_stage_dir" </dev/null >/dev/null 2>&1
  ) &
}

# Remove containers left behind when a launcher died without running its EXIT
# trap (for example SIGKILL or a terminal emulator that closes too abruptly).
# A container whose launcher PID and start time still match is a live session;
# stopped containers and containers with a dead launcher are safe to remove.
remove_stale_containers() {
  local id="" status="" pid="" start="" current=""

  while IFS=$'\t' read -r id status pid start; do
    [[ -n "$id" ]] || continue

    if [[ -n "$pid" && -n "$start" ]]; then
      current="$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)"
      if [[ -n "$current" && "$current" == "$start" ]]; then
        # Launcher is alive: it may still be creating this container.
        continue
      fi

      podman rm -f "$id" >/dev/null 2>&1 || true
      continue
    fi

    # Running container from a launcher that predates these labels: leave it.
    if [[ "$status" == Up* ]]; then
      continue
    fi

    podman rm -f "$id" >/dev/null 2>&1 || true
  done < <(
    podman ps -a \
      --filter "label=pi-sandbox.project" \
      --format '{{.ID}}\t{{.Status}}\t{{.Label "pi-sandbox.launcher-pid"}}\t{{.Label "pi-sandbox.launcher-start"}}' \
      2>/dev/null || true
  )
}

warn_enabled_capabilities() {
  [[ "${PI_SANDBOX_WARN:-1}" == "1" ]] || return 0

  local -a rows=()
  local allow_count=0
  local default_allow=0

  if [[ -z "$scratch_workspace_dir" ]]; then
    if [[ -n "$ephemeral_workspace_dir" ]]; then
      rows+=("workspace  $workspace (ephemeral copy at $ephemeral_workspace_dir; host checkout is not modified)")
    else
      case "$effective_workspace_mode" in
        ro)
          rows+=("workspace  $workspace (read-only; readable data can leave the sandbox)")
          ;;
        rw)
          rows+=("workspace  $workspace (read-write; host-side tools may execute agent-written files)")
          ;;
      esac
    fi
  fi

  if [[ -f "$EGRESS_POLICY" ]]; then
    if grep -Eq '^[[:space:]]*default[[:space:]]+allow([[:space:]]|$)' "$EGRESS_POLICY"; then
      default_allow=1
    fi
    allow_count="$(grep -Ec '^[[:space:]]*allow[[:space:]]' "$EGRESS_POLICY" || true)"
  fi
  if [[ "$default_allow" -eq 1 ]]; then
    rows+=("egress     $EGRESS_POLICY (default allow: all public destinations)")
  elif [[ "$allow_count" -gt 0 ]]; then
    rows+=("egress     $EGRESS_POLICY ($allow_count explicit allow rule(s))")
  fi

  if [[ "$clipboard_mounted" -eq 1 ]]; then
    rows+=("clipboard  host Wayland clipboard visible to the agent")
  fi
  if [[ "$github_enabled" -eq 1 ]]; then
    rows+=("github     GH_TOKEN exported from $STATE_DIR/secrets/gh_token")
  fi
  if [[ "$gpg_forwarded" -eq 1 ]]; then
    rows+=("gpg        host gpg-agent signing socket forwarded")
  fi
  if [[ "$mcp_enabled" -eq 1 ]]; then
    if [[ "$MCP_TOKEN_AVAILABLE" -eq 1 ]]; then
      rows+=("mcp        $MCP_NETWORK network and MCP_TOKEN")
    else
      rows+=("mcp        $MCP_NETWORK network (no token)")
    fi
  fi

  [[ "${#rows[@]}" -gt 0 ]] || return 0

  {
    echo "pi-sandbox: non-default capabilities enabled for this session:"
    printf '  %s\n' "${rows[@]}"
    echo "These are deliberate relaxations of the deny-by-default sandbox."
    echo "Set PI_SANDBOX_WARN=0 to silence this summary and the secret warning."
  } >&2
}

warn_workspace_secrets() {
  local -a found=()

  [[ "${PI_SANDBOX_WARN:-1}" == "1" ]] || return 0
  [[ "$effective_workspace_mode" != "none" ]] || return 0
  [[ "$SECRET_SCAN" == "1" ]] || return 0
  mapfile -t found < <(
    find "$workspace" -maxdepth 6 \
      \( -name .git -o -name node_modules -o -name .venv -o -name vendor -o -name target \) -prune -o \
      \( -type d -name .vaults -o -type f \
         \( -name .env -o -name '.env.*' -o -name '*.vault_pass' -o -name id_rsa \
            -o -name id_ed25519 -o -name id_ecdsa -o -name '*.pem' -o -name '*.key' \
            -o -name .netrc \) \) -print 2>/dev/null | head -n 20
  )

  if [[ "${#found[@]}" -gt 0 ]]; then
    echo "Warning: workspace contains files that look like secrets:" >&2
    printf '  %s\n' "${found[@]}" >&2
    if [[ "$effective_workspace_mode" == "ro" ]]; then
      echo "The workspace is mounted read-only, but Pi can still read and send these files." >&2
    elif [[ -n "$ephemeral_workspace_dir" ]]; then
      echo "The workspace was copied into the sandbox. Pi can read and write these files in the copy." >&2
      echo "The host checkout is not modified, but the parked copy remains untrusted output." >&2
    else
      echo "The workspace is mounted read-write. Move or remove these files if they should not be visible to Pi." >&2
    fi
    echo "Set PI_SANDBOX_SECRET_SCAN=0 to silence this warning." >&2
  fi
}

host_pi_version="$(pi --version 2>/dev/null | head -n 1 | tr -d '[:space:]' || true)"
PI_VERSION="${PI_VERSION:-${host_pi_version:-1.4.0}}"
PI_IMAGE="${PI_IMAGE:-localhost/pi-sandbox:${PI_VERSION}}"
EGRESS_PROXY_IMAGE="${PI_SANDBOX_EGRESS_IMAGE:-localhost/pi-sandbox-egress:${PI_VERSION}}"

PI_BASE_IMAGE="${PI_BASE_IMAGE:-node:24-trixie-slim}"

show_help() {
  cat <<EOF
pi-sandbox - run the Pi coding agent in a rootless Podman sandbox

Usage:
  pi-sandbox [sandbox options] [pi arguments...]
  pi-sandbox -- [pi arguments...]

Sandbox options:
  --workspace PATH          Project path (default: current directory)
  --workspace-mode MODE     none (default), ro, rw, or ephemeral
  --workspace-discard       Remove the ephemeral copy instead of parking it
  --workspace-keep          Park the ephemeral copy (default)
  --mcp                     Enable MCP for this launch
  --no-mcp                  Disable MCP for this launch
  --mcp-token-file PATH     Import an MCP token, then launch
  --gpg-sign                Forward the host gpg-agent for signing
  --no-gpg-sign             Disable gpg signing
  --clipboard               Enable Wayland clipboard access
  --no-clipboard            Disable clipboard access
  --gh-token                Enable the GitHub CLI token
  --no-gh-token             Disable the GitHub CLI token
  --start-egress            Start the shared egress proxy
  --stop-egress             Stop the shared egress proxy
  --restart-egress          Restart the shared egress proxy
  --egress-status           Show egress proxy status
  --check-egress-policy     Validate the egress policy
  --update                  Rebuild the sandbox and egress images
  --dry-run                 Print the podman command and exit
  -h, --help                Show this help and the sandboxed Pi help

Any argument not listed above is passed to the Pi instance inside the
sandbox. Use -- to force the rest of the command line to Pi.

Environment:
  PI_SANDBOX_WORKSPACE_MODE   none, ro, rw, or ephemeral
  PI_SANDBOX_WORKSPACE_DISCARD  1 to remove an ephemeral copy on exit
  PI_SANDBOX_STATE            Runtime state directory
  PI_SANDBOX_CONFIG_DIR       Launcher config directory
  PI_SANDBOX_MCP              1 to enable MCP
  PI_SANDBOX_CLIPBOARD        1 to enable clipboard access
  PI_SANDBOX_GH_TOKEN         1 to enable the GitHub CLI token
  PI_SANDBOX_CPUS             CPU limit (default: 2)
  PI_SANDBOX_NOFILE           File descriptor limit (default: 8192)
  PI_IMAGE                    Sandbox image (default: localhost/pi-sandbox:<version>)

Documentation: docs/usage.md, docs/mcp.md, docs/egress.md
EOF
}

workspace="${PI_WORKSPACE:-$PWD}"
workspace_mode="${PI_SANDBOX_WORKSPACE_MODE:-none}"
update_image=0
dry_run=0
help_requested=0
no_mcp=0
mcp_token_import=""
scratch_workspace_dir=""
ephemeral_workspace_dir=""
ephemeral_workspace_created=0
workspace_mount_source=""
start_egress=0
stop_egress=0
restart_egress=0
egress_status=0
check_egress_policy=0
gpg_sign="$GPG_SIGN"
enable_clipboard="$CLIPBOARD"
enable_gh_token="$GH_TOKEN_ENABLED"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace)
      workspace="${2:?--workspace needs a path}"
      shift 2
      ;;
    --workspace-mode)
      workspace_mode="${2:?--workspace-mode needs none, ro, rw or ephemeral}"
      shift 2
      ;;
    --workspace-discard)
      WORKSPACE_DISCARD=1
      shift
      ;;
    --workspace-keep)
      WORKSPACE_DISCARD=0
      shift
      ;;
    --update)
      update_image=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      help_requested=1
      shift
      ;;
    --mcp)
      MCP_OPT_IN=1
      shift
      ;;
    --no-mcp)
      no_mcp=1
      shift
      ;;
    --start-egress)
      start_egress=1
      shift
      ;;
    --stop-egress)
      stop_egress=1
      shift
      ;;
    --restart-egress)
      restart_egress=1
      shift
      ;;
    --egress-status)
      egress_status=1
      shift
      ;;
    --check-egress-policy)
      check_egress_policy=1
      shift
      ;;
    --gpg-sign)
      gpg_sign=1
      shift
      ;;
    --no-gpg-sign)
      gpg_sign=0
      shift
      ;;
    --clipboard)
      enable_clipboard=1
      shift
      ;;
    --no-clipboard)
      enable_clipboard=0
      shift
      ;;
    --gh-token)
      enable_gh_token=1
      shift
      ;;
    --no-gh-token)
      enable_gh_token=0
      shift
      ;;
    --mcp-token-file)
      mcp_token_import="${2:?--mcp-token-file needs a path}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ "$help_requested" -eq 1 ]]; then
  show_help
  echo
  if command -v podman >/dev/null 2>&1 &&
    podman image exists "$PI_IMAGE" >/dev/null 2>&1; then
    echo "Pi help from $PI_IMAGE (arguments after sandbox options are forwarded to this instance):"
    echo
    podman run --rm --network=none "$PI_IMAGE" pi --help || true
  else
    echo "Pi help is unavailable because $PI_IMAGE is not built." >&2
    echo "Run 'pi-sandbox --update' to build it, then 'pi-sandbox --help' again." >&2
  fi
  exit 0
fi

if ! [[ "$CPUS" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "PI_SANDBOX_CPUS must be a number, for example 2 or 0.5: $CPUS" >&2
  exit 2
fi
if ! [[ "$NOFILE" =~ ^[0-9]+$ ]]; then
  echo "PI_SANDBOX_NOFILE must be an integer, for example 8192: $NOFILE" >&2
  exit 2
fi
case "$workspace_mode" in
  none|ro|rw|ephemeral) ;;
  *)
    echo "PI_SANDBOX_WORKSPACE_MODE must be none, ro, rw or ephemeral: $workspace_mode" >&2
    exit 2
    ;;
esac
case "$WORKSPACE_DISCARD" in
  0|1) ;;
  *)
    echo "PI_SANDBOX_WORKSPACE_DISCARD must be 0 or 1: $WORKSPACE_DISCARD" >&2
    exit 2
    ;;
esac
case "$MCP_OPT_IN" in
  0|1) ;;
  *)
    echo "PI_SANDBOX_MCP must be 0 or 1: $MCP_OPT_IN" >&2
    exit 2
    ;;
esac
for toggle in "$enable_clipboard" "$enable_gh_token"; do
  case "$toggle" in
    0|1) ;;
    *)
      echo "PI_SANDBOX_CLIPBOARD and PI_SANDBOX_GH_TOKEN must be 0 or 1." >&2
      exit 2
      ;;
  esac
done

# Rebuilding the image does not need a workspace and must work from anywhere.
if [[ "$update_image" -eq 1 ]]; then
  echo "Rebuilding Pi image $PI_IMAGE from $PI_BASE_IMAGE with PI_VERSION=$PI_VERSION ..."
  podman build --pull --no-cache \
    --build-arg "BASE_IMAGE=${PI_BASE_IMAGE}" \
    --build-arg "PI_VERSION=$PI_VERSION" \
    -t "$PI_IMAGE" \
    -f "$IMAGE_DIR/pi.Dockerfile" \
    "$IMAGE_DIR"

  echo "Rebuilding egress proxy image $EGRESS_PROXY_IMAGE from $EGRESS_PROXY_BASE_IMAGE ..."
  podman build --pull --no-cache \
    --build-arg "BASE_IMAGE=${EGRESS_PROXY_BASE_IMAGE}" \
    -t "$EGRESS_PROXY_IMAGE" \
    -f "$IMAGE_DIR/egress-proxy.Dockerfile" \
    "$IMAGE_DIR"

  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    podman rm -f "$EGRESS_PROXY_NAME" >/dev/null 2>&1 || true
  fi
  exit 0
fi

if [[ "$stop_egress" -eq 1 ]]; then
  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    podman rm -f "$EGRESS_PROXY_NAME" >/dev/null
    echo "Stopped egress proxy $EGRESS_PROXY_NAME."
  else
    echo "Egress proxy $EGRESS_PROXY_NAME is not present."
  fi
  exit 0
fi

if [[ "$egress_status" -eq 1 ]]; then
  print_egress_status
  exit 0
fi

if [[ "$check_egress_policy" -eq 1 ]]; then
  ensure_egress_policy
  ensure_egress_image
  podman run --rm \
    --network none \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --mount "type=bind,src=$EGRESS_POLICY,dst=/etc/pi-egress/policy.conf,ro" \
    "$EGRESS_PROXY_IMAGE" \
    --check-policy \
    --policy /etc/pi-egress/policy.conf
  exit 0
fi

if [[ "$start_egress" -eq 1 || "$restart_egress" -eq 1 ]]; then
  ensure_egress
  print_egress_status
  exit 0
fi

if [[ ! -d "$workspace" ]]; then
  echo "Workspace is not a directory: $workspace" >&2
  exit 2
fi

workspace="$(realpath "$workspace")"
home_dir="$(realpath "$HOME" 2>/dev/null || printf '%s\n' "$HOME")"

# Mounting $HOME or / read-write would expose far more than a project. For a
# quick chat that does not need local files, substitute a disposable empty
# directory. State and sessions still use a stable "scratch" identity.
if [[ "$workspace" == "/" || "$workspace" == "$home_dir" ]]; then
  broad_workspace="$workspace"
  scratch_workspace_dir="$(mktemp -d "${TMPDIR:-/tmp}/pi-sandbox-scratch.XXXXXX")"
  workspace="$scratch_workspace_dir"
  echo "Workspace is too broad to mount read-write: $broad_workspace" >&2
  echo "Using temporary workspace $workspace" >&2
fi

# A generated scratch directory is disposable and safe to mount read-write
# even when the host project is not mounted.
effective_workspace_mode="$workspace_mode"
if [[ -n "$scratch_workspace_dir" ]]; then
  effective_workspace_mode="rw"
fi

cleanup() {
  # Stop the background podman client first. Otherwise it could still create
  # the container after the remove below, leaving a fresh dangling one.
  if [[ -n "$podman_pid" ]] && kill -0 "$podman_pid" 2>/dev/null; then
    kill -TERM "$podman_pid" 2>/dev/null || true
    wait "$podman_pid" 2>/dev/null || true
  fi

  if [[ "$container_started" -eq 1 && -n "$container_name" ]]; then
    podman rm -f --ignore "$container_name" >/dev/null 2>&1 || true
  fi

  if [[ -n "$scratch_workspace_dir" ]]; then
    rm -rf -- "$scratch_workspace_dir"
  fi

  if [[ "$ephemeral_workspace_created" -eq 1 ]]; then
    if [[ "$WORKSPACE_DISCARD" == "1" || "$container_started" -eq 0 ]]; then
      rm -rf -- "$ephemeral_workspace_dir"
    else
      echo "Ephemeral workspace parked: $ephemeral_workspace_dir" >&2
      echo "Treat it as untrusted agent output; it was not applied to the host checkout." >&2
    fi
  fi

  if [[ -n "$mcp_stage_dir" ]]; then
    rm -rf -- "$mcp_stage_dir"
  fi
}
trap cleanup EXIT
# Run podman in the background below: bash only executes these traps while it
# is waiting, and closing a terminal sends SIGHUP to the whole process group.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Reject a workspace that is, contains, or is contained by a protected root.
# The roots are canonicalized so a symlinked state directory or home subtree
# cannot slip past a string comparison. `/` and `$HOME` are handled by the
# scratch substitution above, so they are not roots here.
canonical_path() {
  realpath -m -- "$1" 2>/dev/null || printf '%s\n' "$1"
}

protected_roots=(
  "$(canonical_path "$home_dir/.ssh")"
  "$(canonical_path "$home_dir/.pi")"
  "$(canonical_path "$STATE_DIR")"
)
for root in "${protected_roots[@]}"; do
  if [[ "$workspace" == "$root" || "$workspace" == "$root"/* || "$root" == "$workspace"/* ]]; then
    echo "Refusing to mount a sensitive path: $workspace overlaps $root" >&2
    exit 2
  fi
done

if [[ -n "$scratch_workspace_dir" ]]; then
  project_name="scratch"
  project_id="scratch"
  state_volume="pi-state-scratch"
  home_volume="pi-home-scratch"
  session_dir="$STATE_DIR/sessions/scratch"
else
  project_name="$(basename "$workspace" | sed 's/[^A-Za-z0-9_.-]/-/g')"
  project_id="$(printf '%s' "$workspace" | sha256sum | cut -c1-10)"
  state_volume="pi-state-${project_id}"
  home_volume="pi-home-${project_id}"
  session_dir="$STATE_DIR/sessions/${project_name}-${project_id}"
fi

# Ephemeral mode copies the checkout into launcher-owned state and mounts the
# copy. The copy is created lazily so --dry-run stays cheap and side-effect free.
workspace_mount_source="$workspace"
if [[ "$effective_workspace_mode" == "ephemeral" ]]; then
  workspaces_root="$STATE_DIR/workspaces"
  if [[ "$dry_run" -eq 1 ]]; then
    ephemeral_workspace_dir="$workspaces_root/${project_name}-${project_id}-dry-run"
  else
    install -d -m 700 "$workspaces_root"
    chmod 700 "$workspaces_root"
    ephemeral_workspace_dir="$(mktemp -d "$workspaces_root/${project_name}-${project_id}.XXXXXX")"
    ephemeral_workspace_created=1
    if ! cp -a --reflink=auto -- "$workspace/." "$ephemeral_workspace_dir/"; then
      echo "Could not copy the workspace to $ephemeral_workspace_dir" >&2
      echo "The host checkout was not modified." >&2
      exit 2
    fi
    # cp -a preserves the source directory mode on the destination. The parked
    # copy is launcher state, not a checkout, so keep it private regardless.
    chmod 700 "$ephemeral_workspace_dir"
    echo "Using ephemeral workspace $ephemeral_workspace_dir" >&2
    echo "Source checkout remains untouched: $workspace" >&2
  fi
  workspace_mount_source="$ephemeral_workspace_dir"
  effective_workspace_mode="rw"
fi

# Pi's footer shows the process working directory. When the project is
# mounted, mirror it at its host path and start Pi there, so the footer
# identifies the actual project (for example ~/code/foo) instead of the
# generic /workspace. With no mount, use an empty writable /workspace.
container_workspace="/workspace"
mirror_mounts=()
workspace_mounts=()
workspace_mount_opts=""

case "$effective_workspace_mode" in
  none)
    workspace_mounts+=(--tmpfs "/workspace:rw,nosuid,nodev,size=64m")
    ;;
  ro)
    workspace_mount_opts=",ro"
    ;;
  rw) ;;
esac

if [[ "$effective_workspace_mode" != "none" ]]; then
  workspace_mounts+=(
    --mount "type=bind,src=$workspace_mount_source,dst=/workspace${workspace_mount_opts}"
  )

  # Only mirror paths under the host home directory. Mounting an arbitrary
  # absolute path over the container root filesystem could hide system files.
  if [[ "$workspace" == "$HOME"/* && "$workspace" != "/workspace" ]]; then
    container_workspace="$workspace"
    mirror_mounts+=(
      --mount "type=bind,src=$workspace_mount_source,dst=$workspace${workspace_mount_opts}"
    )
  fi
fi

container_name="pi-${project_name}-$$"

mkdir -p "$session_dir" "$STATE_DIR/auth" "$STATE_DIR/secrets"
chmod 700 "$STATE_DIR/auth" "$STATE_DIR/secrets" "$session_dir"

# Resolve the MCP contract before any podman command. MCP needs both a host
# opt-in and a project config; --no-mcp wins over both. The sandbox overlay is
# staged so the mount source is launcher-owned, and both config paths are
# checked to stay inside the canonical workspace.
mcp_enabled=0
mcp_config_source=""
mcp_overlay=0
if [[ "$no_mcp" -eq 0 && "$MCP_OPT_IN" -eq 1 && "$effective_workspace_mode" != "none" ]]; then
  if [[ -e "$workspace/$MCP_SANDBOX_CONFIG" ]]; then
    resolved_config="$(resolve_mcp_config "$workspace/$MCP_SANDBOX_CONFIG")" || exit 2
    mcp_enabled=1
    mcp_overlay=1
    mcp_config_source="$(stage_mcp_config "$resolved_config")"
  elif [[ -e "$workspace/$MCP_PROJECT_CONFIG" ]]; then
    mcp_config_source="$(resolve_mcp_config "$workspace/$MCP_PROJECT_CONFIG")" || exit 2
    mcp_enabled=1
  fi
fi

if [[ "$no_mcp" -eq 0 ]]; then
  if [[ -n "$mcp_token_import" ]]; then
    import_mcp_token "$mcp_token_import"
  fi

  if [[ "$mcp_enabled" -eq 1 && -e "$MCP_TOKEN_FILE" ]]; then
    validate_mcp_token_file "$MCP_TOKEN_FILE" || exit 2
    MCP_TOKEN_AVAILABLE=1
  fi
fi

if [[ "$mcp_enabled" -eq 1 && "$MCP_TOKEN_AVAILABLE" -eq 0 ]]; then
  if [[ "${PI_SANDBOX_ALLOW_NO_MCP_TOKEN:-0}" == "1" ]]; then
    echo "Warning: launching with $mcp_config_source but no MCP token (PI_SANDBOX_ALLOW_NO_MCP_TOKEN=1)." >&2
  else
    echo "Missing MCP token for $mcp_config_source: $MCP_TOKEN_FILE" >&2
    echo "Install it with: install -m 600 ~/.config/server-mcp/secrets/http-token \"$MCP_TOKEN_FILE\"" >&2
    echo "Or import it with: pi-sandbox --mcp-token-file ~/.config/server-mcp/secrets/http-token" >&2
    echo "Set PI_SANDBOX_ALLOW_NO_MCP_TOKEN=1 only for diagnostics, or pass --no-mcp to skip MCP." >&2
    exit 2
  fi
fi

# Create the fixed networks and start the shared egress proxy. The sandbox is
# attached only to the internal egress network; the proxy is the only container
# with a public uplink. The MCP network stays internal and is only needed when
# the project opts in.
if [[ "$dry_run" -eq 0 ]]; then
  remove_stale_containers
  ensure_egress

  if [[ "$mcp_enabled" -eq 1 ]]; then
    ensure_internal_network "$MCP_NETWORK"

    if [[ -z "$(podman ps -a --filter "network=$MCP_NETWORK" --format '{{.ID}}' 2>/dev/null || true)" ]]; then
      echo "Hint: no MCP container is attached to $MCP_NETWORK; the server-mcp stack appears to be down." >&2
    fi
  fi
fi

if [[ "$dry_run" -eq 0 ]] && ! podman image exists "$PI_IMAGE"; then
  echo "Building Pi image $PI_IMAGE from $PI_BASE_IMAGE ..."
  podman build \
    --build-arg "BASE_IMAGE=${PI_BASE_IMAGE}" \
    -t "$PI_IMAGE" \
    -f "$IMAGE_DIR/pi.Dockerfile" \
    "$IMAGE_DIR"
fi

mounts=()
proxy_url="http://${EGRESS_PROXY_NAME}:3128"
envs=(
  --env "HOME=/home/$USER"
  --env "PI_CODING_AGENT_DIR=/state/pi-agent"
  --env "PI_CODING_AGENT_SESSION_DIR=/sessions"
  --env "PI_SANDBOX_PROJECT=$project_name"
  --env "GIT_TERMINAL_PROMPT=0"
  --env "HTTP_PROXY=$proxy_url"
  --env "HTTPS_PROXY=$proxy_url"
  --env "ALL_PROXY=$proxy_url"
  --env "NO_PROXY=$NO_PROXY_VALUE"
  --env "http_proxy=$proxy_url"
  --env "https_proxy=$proxy_url"
  --env "all_proxy=$proxy_url"
  --env "no_proxy=$NO_PROXY_VALUE"
)
networks=(--network "$EGRESS_NETWORK")

# Pi intercepts Ctrl+V, reads an image from the Wayland clipboard with
# wl-paste, and writes its own /tmp/pi-clipboard-<uuid>.<ext> inside the
# container. Expose only the compositor socket, not the whole runtime dir.
if [[ "$enable_clipboard" == "1" && -n "${WAYLAND_DISPLAY:-}" ]]; then
  wayland_socket="$WAYLAND_DISPLAY"
  if [[ "$wayland_socket" != /* ]]; then
    if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
      wayland_socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
    else
      wayland_socket=""
    fi
  fi

  if [[ -n "$wayland_socket" && -S "$wayland_socket" ]]; then
    mounts+=(--mount "type=bind,src=$wayland_socket,dst=/tmp/wayland-0,ro")
    envs+=(--env "WAYLAND_DISPLAY=/tmp/wayland-0" --env "XDG_RUNTIME_DIR=/tmp")
    clipboard_mounted=1
  fi
fi

# Use the host git identity inside the container so commits and annotated tags
# work without mounting the host ~/.gitconfig.
git_name="$(git config --global user.name 2>/dev/null || true)"
git_email="$(git config --global user.email 2>/dev/null || true)"
if [[ -n "$git_name" ]]; then
  envs+=(--env "GIT_AUTHOR_NAME=$git_name" --env "GIT_COMMITTER_NAME=$git_name")
fi
if [[ -n "$git_email" ]]; then
  envs+=(--env "GIT_AUTHOR_EMAIL=$git_email" --env "GIT_COMMITTER_EMAIL=$git_email")
fi

# Forward the host gpg-agent extra socket for commit and tag signing only when
# explicitly enabled with --gpg-sign or PI_SANDBOX_GPG_SIGN=1. Only public key
# material is copied into the container: private keys stay on the host, and the
# extra socket cannot export them. SSH signing is not forwarded by this launcher.
gpg_format="$(git config --global --get gpg.format 2>/dev/null || true)"
signing_key="$(git config --global --get user.signingkey 2>/dev/null || true)"
commit_gpgsign="$(git config --global --get commit.gpgsign 2>/dev/null || true)"
tag_gpgsign="$(git config --global --get tag.gpgsign 2>/dev/null || true)"
if [[ "$gpg_sign" == "1" ]] \
  && [[ "${gpg_format:-openpgp}" == "openpgp" ]] \
  && [[ -n "$signing_key" || "$commit_gpgsign" == "true" || "$tag_gpgsign" == "true" ]] \
  && command -v gpgconf >/dev/null 2>&1; then
  host_gpg_home="$(gpgconf --list-dirs homedir 2>/dev/null || true)"
  gpg_extra_socket="$(gpgconf --list-dirs agent-extra-socket 2>/dev/null || true)"

  if [[ -n "$gpg_extra_socket" && ! -S "$gpg_extra_socket" ]]; then
    gpgconf --launch gpg-agent >/dev/null 2>&1 || true
  fi

  if [[ -n "$host_gpg_home" && -n "$gpg_extra_socket" && -S "$gpg_extra_socket" ]]; then
    gpg_home="$STATE_DIR/gpg/home"
    install -d -m 700 "$STATE_DIR/gpg" "$gpg_home"
    for file in pubring.kbx trustdb.gpg gpg.conf; do
      if [[ -f "$host_gpg_home/$file" ]]; then
        install -m 600 "$host_gpg_home/$file" "$gpg_home/$file"
      fi
    done

    # gpg may put its agent socket below /run/user when a runtime dir exists;
    # leave that subtree writable so the entrypoint can link the forwarded
    # socket wherever gpgconf reports.
    mounts+=(
      --tmpfs "/run/user:rw,nosuid,nodev,size=16m,mode=1777"
      --mount "type=bind,src=$gpg_home,dst=/gpg"
      --mount "type=bind,src=$gpg_extra_socket,dst=/run/gpg-agent/S.gpg-agent,ro"
    )
    envs+=(--env "GNUPGHOME=/gpg")
    gpg_forwarded=1

    git_config=("gpg.program=gpg")
    if [[ -n "$signing_key" ]]; then
      git_config+=("user.signingkey=$signing_key")
    fi
    if [[ "$commit_gpgsign" == "true" ]]; then
      git_config+=("commit.gpgsign=true")
    fi
    if [[ "$tag_gpgsign" == "true" ]]; then
      git_config+=("tag.gpgsign=true")
    fi

    # Git reads these without writing to the container's ~/.gitconfig.
    envs+=(--env "GIT_CONFIG_COUNT=${#git_config[@]}")
    for i in "${!git_config[@]}"; do
      envs+=(
        --env "GIT_CONFIG_KEY_$i=${git_config[$i]%%=*}"
        --env "GIT_CONFIG_VALUE_$i=${git_config[$i]#*=}"
      )
    done
  fi
fi

# Global, non-secret Pi configuration. Never mount auth.json, trust.json,
# sessions, mcp-auth.json or the whole ~/.pi/agent directory.
for file in settings.json models.json AGENTS.md; do
  if [[ -f "$HOME/.pi/agent/$file" ]]; then
    mounts+=(--mount "type=bind,src=$HOME/.pi/agent/$file,dst=/global-pi/$file,ro")
  fi
done

for dir in prompts skills themes extensions; do
  if [[ -d "$HOME/.pi/agent/$dir" ]]; then
    mounts+=(--mount "type=bind,src=$HOME/.pi/agent/$dir,dst=/global-pi/$dir,ro")
  fi
done

# Credentials are seeded from a read-only host directory into a per-container
# tmpfs. Login and OAuth refreshes never write back to the host file, so a
# compromised sandbox cannot poison future sessions. Create the host auth
# directory once and copy auth.json into it if you want a single /login for all
# containers.
mounts+=(
  --mount "type=bind,src=$STATE_DIR/auth,dst=/auth-seed,ro"
  --tmpfs "/shared-auth:rw,nosuid,nodev,size=1m,mode=1777"
)

# Optional GitHub CLI token. It is a capability: any Pi container with this
# environment variable can use GitHub as that token. Prefer a fine-grained PAT.
if [[ "$enable_gh_token" == "1" && -f "$STATE_DIR/secrets/gh_token" ]]; then
  gh_token="$(<"$STATE_DIR/secrets/gh_token")"
  export GH_TOKEN="$gh_token"
  mounts+=(--mount "type=bind,src=$STATE_DIR/secrets/gh_token,dst=/secrets/gh_token,ro")
  envs+=(--env GH_TOKEN)
  github_enabled=1
elif [[ "$enable_gh_token" != "1" && -f "$STATE_DIR/secrets/gh_token" ]]; then
  echo "GitHub token file is present but disabled; set PI_SANDBOX_GH_TOKEN=1 to enable it." >&2
fi

# A sandbox-specific MCP file is overlaid on the project's .pi/mcp.json inside
# the container. The host file can therefore stay a host-run development config.
# The overlay comes after the workspace mounts so it wins over the bind mount.
if [[ "$mcp_overlay" -eq 1 ]]; then
  mirror_mounts+=(
    --mount "type=bind,src=$mcp_config_source,dst=$container_workspace/$MCP_PROJECT_CONFIG,ro"
  )
fi

# Only projects that declare an MCP server get the control network and token.
# MCP_TOKEN is exported here and inherited by `podman run --env MCP_TOKEN`; its
# value is never placed in the podman argv.
if [[ "$mcp_enabled" -eq 1 ]]; then
  networks+=(--network "$MCP_NETWORK")

  if [[ "$MCP_TOKEN_AVAILABLE" -eq 1 ]]; then
    export MCP_TOKEN="$MCP_TOKEN_VALUE"
    envs+=(--env MCP_TOKEN)
  fi
fi

warn_enabled_capabilities
warn_workspace_secrets

run_cmd=(
  podman run --rm -it \
    --name "$container_name" \
    --label "pi-sandbox.project=$project_name" \
    --label "pi-sandbox.launcher-pid=$launcher_pid" \
    --label "pi-sandbox.launcher-start=$launcher_start" \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --init \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --pids-limit=512 \
    --memory=4g \
    --cpus="$CPUS" \
    --ulimit "nofile=${NOFILE}:${NOFILE}" \
    --workdir "$container_workspace" \
    --mount "type=volume,src=$home_volume,dst=/home/$USER" \
    "${workspace_mounts[@]}" \
    --mount "type=volume,src=$state_volume,dst=/state/pi-agent" \
    --mount "type=bind,src=$session_dir,dst=/sessions" \
    --tmpfs "/tmp:rw,nosuid,nodev" \
    "${mounts[@]}" \
    "${mirror_mounts[@]}" \
    "${envs[@]}" \
    "${networks[@]}" \
    "$PI_IMAGE" pi \
    --extension /usr/local/share/pi-sandbox/sandbox-status.ts \
    "$@"
)

if [[ "$dry_run" -eq 1 ]]; then
  # The command only contains `--env MCP_TOKEN`; the value is not in argv.
  printf '%q ' "${run_cmd[@]}"
  printf '\n'
  exit 0
fi

start_cleanup_watchdog

# Keep podman in the background so the traps above run as soon as the
# terminal hangs up; a foreground `podman run` defers them until it exits.
container_started=1
# The explicit stdin redirection overrides bash's /dev/null for async commands.
"${run_cmd[@]}" <&0 &
podman_pid=$!
status=0
wait "$podman_pid" || status=$?
exit "$status"

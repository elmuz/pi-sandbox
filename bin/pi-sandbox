#!/usr/bin/env bash
#
# Launch an interactive Pi coding-agent container with:
#   - only the project workspace bind-mounted read-write
#   - read-only global Pi config
#   - per-project state and session storage
#   - shared provider/MCP credentials
#   - no Podman/Docker socket, no host home, no host namespaces
#
# Usage:
#   cd /path/to/project
#   pi-sandbox [pi arguments...]
#   pi-sandbox --workspace /path/to/project [pi arguments...]
#   pi-sandbox --dry-run
#   pi-sandbox --mcp-token-file PATH
#   pi-sandbox --no-mcp
#   pi-sandbox --update
#   pi-sandbox --gpg-sign
#   pi-sandbox --start-egress
#   pi-sandbox --stop-egress
#   pi-sandbox --egress-status
#
# The sandbox has no direct internet route. A shared egress proxy container is
# the only member with a public network; the sandbox joins the internal
# pi-egress network and uses HTTP(S)_PROXY. The proxy allows public destinations
# and blocks non-public ones unless the host-owned policy allows them.
#
# Starting in $HOME or / uses a temporary empty workspace instead of mounting
# that directory. The temporary directory is removed when the container exits.
# Its Pi state and sessions use the stable name "scratch".
#
# The MCP control network is attached only when the project has
# .pi/mcp.json. The shared MCP bearer token is read from
# $PI_SANDBOX_STATE/secrets/mcp_token when that file exists, validated against
# the server-mcp token rules, and passed to the container as MCP_TOKEN through
# the environment. The token value never appears in the podman argv or in
# --dry-run output.
#
# Source assets live in this repository. Writable runtime state lives in
# ${XDG_DATA_HOME:-$HOME/.local/share}/pi-sandbox by default.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
IMAGE_DIR="$REPO_DIR/image"
CONFIG_DIR="${PI_SANDBOX_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pi-sandbox}"
CONFIG_FILE="$CONFIG_DIR/config"

# Optional host-owned launcher configuration. It is sourced before defaults,
# so environment variables and command-line flags can still override it.
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

STATE_DIR="${PI_SANDBOX_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/pi-sandbox}"
MCP_NETWORK="${PI_SANDBOX_MCP_NETWORK:-pi-control}"
MCP_TOKEN_FILE="${PI_SANDBOX_MCP_TOKEN_FILE:-$STATE_DIR/secrets/mcp_token}"
MCP_PROJECT_CONFIG=".pi/mcp.json"
MCP_TOKEN_VALUE=""
MCP_TOKEN_AVAILABLE=0
EGRESS_NETWORK="${PI_SANDBOX_EGRESS_NETWORK:-pi-egress}"
EGRESS_UPLINK="${PI_SANDBOX_EGRESS_UPLINK:-pi-egress-uplink}"
EGRESS_PROXY_NAME="${PI_SANDBOX_EGRESS_PROXY_NAME:-pi-egress-proxy}"
EGRESS_POLICY="${PI_SANDBOX_EGRESS_POLICY:-$CONFIG_DIR/egress-policy.conf}"
EGRESS_PROXY_BASE_IMAGE="${PI_EGRESS_PROXY_BASE_IMAGE:-python:3.12-slim}"
NO_PROXY_DEFAULT="localhost,127.0.0.1,::1,$MCP_NETWORK,mcp-remote,mcp-disk"
NO_PROXY_VALUE="${PI_SANDBOX_NO_PROXY:-$NO_PROXY_DEFAULT}"
GPG_SIGN="${PI_SANDBOX_GPG_SIGN:-0}"

# Match the server-mcp token-file rule: regular, non-empty, one line, and
# readable by the owner only. The value is kept in a variable, never in argv.
validate_mcp_token_file() {
  local file="$1"
  local mode=""
  local -a token_lines=()

  if [[ ! -f "$file" ]]; then
    echo "MCP token file is not a regular file: $file" >&2
    return 1
  fi

  mode="$(stat -Lc '%a' "$file" 2>/dev/null || true)"
  case "$mode" in
    400|600|0400|0600) ;;
    *)
      echo "MCP token file must be mode 0600 or 0400 without group/other access (found ${mode:-unknown}): $file" >&2
      return 1
      ;;
  esac

  if ! mapfile -t token_lines < "$file"; then
    echo "MCP token file is not readable: $file" >&2
    return 1
  fi

  if [[ "${#token_lines[@]}" -eq 0 || -z "${token_lines[0]:-}" ]]; then
    echo "MCP token file is empty: $file" >&2
    return 1
  fi

  if [[ "${#token_lines[@]}" -ne 1 ]]; then
    echo "MCP token file must contain a single line: $file" >&2
    return 1
  fi

  MCP_TOKEN_VALUE="${token_lines[0]}"
}

import_mcp_token() {
  local source="$1"
  local source_real=""
  local destination_real=""

  validate_mcp_token_file "$source" || exit 2

  source_real="$(realpath "$source")"
  destination_real="$(realpath -m "$MCP_TOKEN_FILE")"

  if [[ "$source_real" != "$destination_real" ]]; then
    install -d -m 700 "$(dirname "$MCP_TOKEN_FILE")"
    install -m 600 "$source" "$MCP_TOKEN_FILE"
  fi
}

ensure_egress_policy() {
  if [[ -f "$EGRESS_POLICY" ]]; then
    return
  fi

  install -d -m 700 "$(dirname "$EGRESS_POLICY")"
  (
    umask 077
    cat > "$EGRESS_POLICY" <<'EOF'
# pi-sandbox egress policy.
#
# The sandbox has no direct internet or LAN route. Public destinations are
# allowed through the egress proxy; non-public addresses are blocked. Add
# explicit rules only when you need them:
#
#   deny  <hostname|IP|CIDR> [port]   # block a destination
#   allow <hostname|IP|CIDR> [port]   # permit a private/local destination
#
# Explicit deny wins over explicit allow. Hostname rules also match subdomains.
# Add the MCP target here when it is on a public address, for example:
#   deny catafalco.example.com
#   deny 203.0.113.10
EOF
  )
  chmod 600 "$EGRESS_POLICY"
}

ensure_internal_network() {
  local name="$1"
  local internal=""

  if podman network exists "$name" >/dev/null 2>&1; then
    internal="$(podman network inspect --format '{{.Internal}}' "$name" 2>/dev/null || true)"
    if [[ "$internal" == "true" ]]; then
      return
    fi

    echo "Egress network $name exists but is not internal." >&2
    echo "Stop the containers attached to it, then remove it once:" >&2
    echo "  podman ps -a --filter network=$name" >&2
    echo "  podman network rm $name" >&2
    echo "The next launch recreates it with --internal." >&2
    return 1
  fi

  podman network create --internal "$name" >/dev/null
}

ensure_egress_networks() {
  ensure_internal_network "$EGRESS_NETWORK"
  if ! podman network exists "$EGRESS_UPLINK" >/dev/null 2>&1; then
    podman network create "$EGRESS_UPLINK" >/dev/null
  fi
}

ensure_egress_image() {
  if podman image exists "$EGRESS_PROXY_IMAGE" >/dev/null 2>&1; then
    return
  fi

  echo "Building egress proxy image $EGRESS_PROXY_IMAGE from $EGRESS_PROXY_BASE_IMAGE ..."
  podman build \
    --build-arg "BASE_IMAGE=${EGRESS_PROXY_BASE_IMAGE}" \
    -t "$EGRESS_PROXY_IMAGE" \
    -f "$IMAGE_DIR/egress-proxy.Dockerfile" \
    "$IMAGE_DIR"
}

ensure_egress_proxy() {
  ensure_egress_policy

  if [[ "$restart_egress" -eq 1 ]]; then
    podman rm -f "$EGRESS_PROXY_NAME" >/dev/null 2>&1 || true
  fi

  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    if [[ "$(podman container inspect --format '{{.State.Running}}' "$EGRESS_PROXY_NAME" 2>/dev/null || true)" != "true" ]]; then
      podman start "$EGRESS_PROXY_NAME" >/dev/null
    fi
    return
  fi

  podman run -d --rm \
    --name "$EGRESS_PROXY_NAME" \
    --hostname "$EGRESS_PROXY_NAME" \
    --label "pi-sandbox.egress-proxy=1" \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --pids-limit=128 \
    --memory=256m \
    --cpus=1 \
    --network "$EGRESS_NETWORK" \
    --network "$EGRESS_UPLINK" \
    --tmpfs "/tmp:rw,nosuid,nodev,size=16m" \
    --mount "type=bind,src=$EGRESS_POLICY,dst=/etc/pi-egress/policy.conf,ro" \
    --env "PYTHONUNBUFFERED=1" \
    "$EGRESS_PROXY_IMAGE" >/dev/null
}

ensure_egress() {
  ensure_egress_networks
  ensure_egress_image
  ensure_egress_proxy
}

print_egress_status() {
  local internal="unknown"
  local running="no"
  local image="missing"

  if podman network exists "$EGRESS_NETWORK" >/dev/null 2>&1; then
    internal="$(podman network inspect --format '{{.Internal}}' "$EGRESS_NETWORK" 2>/dev/null || true)"
  fi
  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    running="$(podman container inspect --format '{{.State.Running}}' "$EGRESS_PROXY_NAME" 2>/dev/null || echo unknown)"
  fi
  if podman image exists "$EGRESS_PROXY_IMAGE" >/dev/null 2>&1; then
    image="present"
  fi

  printf 'egress network: %s (internal=%s)\n' "$EGRESS_NETWORK" "${internal:-unknown}"
  printf 'egress uplink:  %s\n' "$EGRESS_UPLINK"
  printf 'proxy image:    %s (%s)\n' "$EGRESS_PROXY_IMAGE" "$image"
  printf 'proxy container: %s (running=%s)\n' "$EGRESS_PROXY_NAME" "$running"
  printf 'policy:         %s\n' "$EGRESS_POLICY"
  printf 'no_proxy:       %s\n' "$NO_PROXY_VALUE"
}

host_pi_version="$(pi --version 2>/dev/null | head -n 1 | tr -d '[:space:]' || true)"
PI_VERSION="${PI_VERSION:-${host_pi_version:-1.4.0}}"
PI_IMAGE="${PI_IMAGE:-localhost/pi-sandbox:${PI_VERSION}}"
EGRESS_PROXY_IMAGE="${PI_SANDBOX_EGRESS_IMAGE:-localhost/pi-sandbox-egress:${PI_VERSION}}"

PI_BASE_IMAGE="${PI_BASE_IMAGE:-node:24-trixie-slim}"

workspace="${PI_WORKSPACE:-$PWD}"
update_image=0
dry_run=0
no_mcp=0
mcp_token_import=""
scratch_workspace_dir=""
start_egress=0
stop_egress=0
restart_egress=0
egress_status=0
check_egress_policy=0
gpg_sign="$GPG_SIGN"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace)
      workspace="${2:?--workspace needs a path}"
      shift 2
      ;;
    --update)
      update_image=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --no-mcp)
      no_mcp=1
      shift
      ;;
    --start-egress)
      start_egress=1
      shift
      ;;
    --stop-egress)
      stop_egress=1
      shift
      ;;
    --restart-egress)
      restart_egress=1
      shift
      ;;
    --egress-status)
      egress_status=1
      shift
      ;;
    --check-egress-policy)
      check_egress_policy=1
      shift
      ;;
    --gpg-sign)
      gpg_sign=1
      shift
      ;;
    --no-gpg-sign)
      gpg_sign=0
      shift
      ;;
    --mcp-token-file)
      mcp_token_import="${2:?--mcp-token-file needs a path}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

# Rebuilding the image does not need a workspace and must work from anywhere.
if [[ "$update_image" -eq 1 ]]; then
  echo "Rebuilding Pi image $PI_IMAGE from $PI_BASE_IMAGE with PI_VERSION=$PI_VERSION ..."
  podman build --pull --no-cache \
    --build-arg "BASE_IMAGE=${PI_BASE_IMAGE}" \
    --build-arg "PI_VERSION=$PI_VERSION" \
    -t "$PI_IMAGE" \
    -f "$IMAGE_DIR/pi.Dockerfile" \
    "$IMAGE_DIR"

  echo "Rebuilding egress proxy image $EGRESS_PROXY_IMAGE from $EGRESS_PROXY_BASE_IMAGE ..."
  podman build --pull --no-cache \
    --build-arg "BASE_IMAGE=${EGRESS_PROXY_BASE_IMAGE}" \
    -t "$EGRESS_PROXY_IMAGE" \
    -f "$IMAGE_DIR/egress-proxy.Dockerfile" \
    "$IMAGE_DIR"

  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    podman rm -f "$EGRESS_PROXY_NAME" >/dev/null 2>&1 || true
  fi
  exit 0
fi

if [[ "$stop_egress" -eq 1 ]]; then
  if podman container exists "$EGRESS_PROXY_NAME" >/dev/null 2>&1; then
    podman rm -f "$EGRESS_PROXY_NAME" >/dev/null
    echo "Stopped egress proxy $EGRESS_PROXY_NAME."
  else
    echo "Egress proxy $EGRESS_PROXY_NAME is not present."
  fi
  exit 0
fi

if [[ "$egress_status" -eq 1 ]]; then
  print_egress_status
  exit 0
fi

if [[ "$check_egress_policy" -eq 1 ]]; then
  ensure_egress_policy
  ensure_egress_image
  podman run --rm \
    --network none \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --mount "type=bind,src=$EGRESS_POLICY,dst=/etc/pi-egress/policy.conf,ro" \
    "$EGRESS_PROXY_IMAGE" \
    --check-policy \
    --policy /etc/pi-egress/policy.conf
  exit 0
fi

if [[ "$start_egress" -eq 1 || "$restart_egress" -eq 1 ]]; then
  ensure_egress
  print_egress_status
  exit 0
fi

if [[ ! -d "$workspace" ]]; then
  echo "Workspace is not a directory: $workspace" >&2
  exit 2
fi

workspace="$(realpath "$workspace")"
home_dir="$(realpath "$HOME" 2>/dev/null || printf '%s\n' "$HOME")"

# Mounting $HOME or / read-write would expose far more than a project. For a
# quick chat that does not need local files, substitute a disposable empty
# directory. State and sessions still use a stable "scratch" identity.
if [[ "$workspace" == "/" || "$workspace" == "$home_dir" ]]; then
  broad_workspace="$workspace"
  scratch_workspace_dir="$(mktemp -d "${TMPDIR:-/tmp}/pi-sandbox-scratch.XXXXXX")"
  workspace="$scratch_workspace_dir"
  echo "Workspace is too broad to mount read-write: $broad_workspace" >&2
  echo "Using temporary workspace $workspace" >&2
fi

if [[ -n "$scratch_workspace_dir" ]]; then
  cleanup_scratch() {
    rm -rf -- "$scratch_workspace_dir"
  }
  trap cleanup_scratch EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
fi

case "$workspace" in
  /|"$home_dir/.ssh"|"$home_dir/.pi"|"$STATE_DIR")
    echo "Refusing to mount sensitive path read-write: $workspace" >&2
    exit 2
    ;;
esac

if [[ -n "$scratch_workspace_dir" ]]; then
  project_name="scratch"
  project_id="scratch"
  state_volume="pi-state-scratch"
  home_volume="pi-home-scratch"
  session_dir="$STATE_DIR/sessions/scratch"
else
  project_name="$(basename "$workspace" | sed 's/[^A-Za-z0-9_.-]/-/g')"
  project_id="$(printf '%s' "$workspace" | sha256sum | cut -c1-10)"
  state_volume="pi-state-${project_id}"
  home_volume="pi-home-${project_id}"
  session_dir="$STATE_DIR/sessions/${project_name}-${project_id}"
fi

# Pi's footer shows the process working directory. Mirror the project at its
# host path and start Pi there, so the footer identifies the actual project
# (for example ~/code/foo) instead of the generic /workspace.
container_workspace="/workspace"
mirror_mounts=()

# Only mirror paths under the host home directory. Mounting an arbitrary
# absolute path over the container root filesystem could hide system files.
if [[ "$workspace" == "$HOME"/* && "$workspace" != "/workspace" ]]; then
  container_workspace="$workspace"
  mirror_mounts+=(--mount "type=bind,src=$workspace,dst=$workspace")
fi

mkdir -p "$session_dir" "$STATE_DIR/auth" "$STATE_DIR/secrets"
chmod 700 "$STATE_DIR/auth" "$STATE_DIR/secrets" "$session_dir"

# Resolve the MCP contract before any podman command. A project opts in with
# .pi/mcp.json; --no-mcp skips the contract for one launch. If a token exists it
# is validated even when this project does not use MCP, so a bad global token
# cannot silently reach a later launch.
mcp_enabled=0
if [[ "$no_mcp" -eq 0 && -f "$workspace/$MCP_PROJECT_CONFIG" ]]; then
  mcp_enabled=1
fi

if [[ "$no_mcp" -eq 0 ]]; then
  if [[ -n "$mcp_token_import" ]]; then
    import_mcp_token "$mcp_token_import"
  fi

  if [[ -e "$MCP_TOKEN_FILE" ]]; then
    validate_mcp_token_file "$MCP_TOKEN_FILE" || exit 2
    MCP_TOKEN_AVAILABLE=1
  fi
fi

if [[ "$mcp_enabled" -eq 1 && "$MCP_TOKEN_AVAILABLE" -eq 0 ]]; then
  if [[ "${PI_SANDBOX_ALLOW_NO_MCP_TOKEN:-0}" == "1" ]]; then
    echo "Warning: launching with $MCP_PROJECT_CONFIG but no MCP token (PI_SANDBOX_ALLOW_NO_MCP_TOKEN=1)." >&2
  else
    echo "Missing MCP token for $workspace/$MCP_PROJECT_CONFIG: $MCP_TOKEN_FILE" >&2
    echo "Install it with: install -m 600 ~/.config/server-mcp/secrets/http-token \"$MCP_TOKEN_FILE\"" >&2
    echo "Or import it with: pi-sandbox --mcp-token-file ~/.config/server-mcp/secrets/http-token" >&2
    echo "Set PI_SANDBOX_ALLOW_NO_MCP_TOKEN=1 only for diagnostics, or pass --no-mcp to skip MCP." >&2
    exit 2
  fi
fi

# Create the fixed networks and start the shared egress proxy. The sandbox is
# attached only to the internal egress network; the proxy is the only container
# with a public uplink. The MCP network stays internal and is only needed when
# the project opts in.
if [[ "$dry_run" -eq 0 ]]; then
  ensure_egress

  if [[ "$mcp_enabled" -eq 1 ]]; then
    ensure_internal_network "$MCP_NETWORK"

    if [[ -z "$(podman ps -a --filter "network=$MCP_NETWORK" --format '{{.ID}}' 2>/dev/null || true)" ]]; then
      echo "Hint: no MCP container is attached to $MCP_NETWORK; the server-mcp stack appears to be down." >&2
    fi
  fi
fi

if [[ "$dry_run" -eq 0 ]] && ! podman image exists "$PI_IMAGE"; then
  echo "Building Pi image $PI_IMAGE from $PI_BASE_IMAGE ..."
  podman build \
    --build-arg "BASE_IMAGE=${PI_BASE_IMAGE}" \
    -t "$PI_IMAGE" \
    -f "$IMAGE_DIR/pi.Dockerfile" \
    "$IMAGE_DIR"
fi

mounts=()
proxy_url="http://${EGRESS_PROXY_NAME}:3128"
envs=(
  --env "HOME=/home/$USER"
  --env "PI_CODING_AGENT_DIR=/state/pi-agent"
  --env "PI_CODING_AGENT_SESSION_DIR=/sessions"
  --env "PI_SANDBOX_PROJECT=$project_name"
  --env "GIT_TERMINAL_PROMPT=0"
  --env "HTTP_PROXY=$proxy_url"
  --env "HTTPS_PROXY=$proxy_url"
  --env "ALL_PROXY=$proxy_url"
  --env "NO_PROXY=$NO_PROXY_VALUE"
  --env "http_proxy=$proxy_url"
  --env "https_proxy=$proxy_url"
  --env "all_proxy=$proxy_url"
  --env "no_proxy=$NO_PROXY_VALUE"
)
networks=(--network "$EGRESS_NETWORK")

# Pi intercepts Ctrl+V, reads an image from the Wayland clipboard with
# wl-paste, and writes its own /tmp/pi-clipboard-<uuid>.<ext> inside the
# container. Expose only the compositor socket, not the whole runtime dir.
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  wayland_socket="$WAYLAND_DISPLAY"
  if [[ "$wayland_socket" != /* ]]; then
    if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
      wayland_socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
    else
      wayland_socket=""
    fi
  fi

  if [[ -n "$wayland_socket" && -S "$wayland_socket" ]]; then
    mounts+=(--mount "type=bind,src=$wayland_socket,dst=/tmp/wayland-0,ro")
    envs+=(--env "WAYLAND_DISPLAY=/tmp/wayland-0" --env "XDG_RUNTIME_DIR=/tmp")
  fi
fi

# Use the host git identity inside the container so commits and annotated tags
# work without mounting the host ~/.gitconfig.
git_name="$(git config --global user.name 2>/dev/null || true)"
git_email="$(git config --global user.email 2>/dev/null || true)"
if [[ -n "$git_name" ]]; then
  envs+=(--env "GIT_AUTHOR_NAME=$git_name" --env "GIT_COMMITTER_NAME=$git_name")
fi
if [[ -n "$git_email" ]]; then
  envs+=(--env "GIT_AUTHOR_EMAIL=$git_email" --env "GIT_COMMITTER_EMAIL=$git_email")
fi

# Forward the host gpg-agent extra socket for commit and tag signing only when
# explicitly enabled with --gpg-sign or PI_SANDBOX_GPG_SIGN=1. Only public key
# material is copied into the container: private keys stay on the host, and the
# extra socket cannot export them. SSH signing is not forwarded by this launcher.
gpg_format="$(git config --global --get gpg.format 2>/dev/null || true)"
signing_key="$(git config --global --get user.signingkey 2>/dev/null || true)"
commit_gpgsign="$(git config --global --get commit.gpgsign 2>/dev/null || true)"
tag_gpgsign="$(git config --global --get tag.gpgsign 2>/dev/null || true)"
if [[ "$gpg_sign" == "1" ]] \
  && [[ "${gpg_format:-openpgp}" == "openpgp" ]] \
  && [[ -n "$signing_key" || "$commit_gpgsign" == "true" || "$tag_gpgsign" == "true" ]] \
  && command -v gpgconf >/dev/null 2>&1; then
  host_gpg_home="$(gpgconf --list-dirs homedir 2>/dev/null || true)"
  gpg_extra_socket="$(gpgconf --list-dirs agent-extra-socket 2>/dev/null || true)"

  if [[ -n "$gpg_extra_socket" && ! -S "$gpg_extra_socket" ]]; then
    gpgconf --launch gpg-agent >/dev/null 2>&1 || true
  fi

  if [[ -n "$host_gpg_home" && -n "$gpg_extra_socket" && -S "$gpg_extra_socket" ]]; then
    gpg_home="$STATE_DIR/gpg/home"
    install -d -m 700 "$STATE_DIR/gpg" "$gpg_home"
    for file in pubring.kbx trustdb.gpg gpg.conf; do
      if [[ -f "$host_gpg_home/$file" ]]; then
        install -m 600 "$host_gpg_home/$file" "$gpg_home/$file"
      fi
    done

    # gpg may put its agent socket below /run/user when a runtime dir exists;
    # leave that subtree writable so the entrypoint can link the forwarded
    # socket wherever gpgconf reports.
    mounts+=(
      --tmpfs "/run/user:rw,nosuid,nodev,size=16m,mode=1777"
      --mount "type=bind,src=$gpg_home,dst=/gpg"
      --mount "type=bind,src=$gpg_extra_socket,dst=/run/gpg-agent/S.gpg-agent,ro"
    )
    envs+=(--env "GNUPGHOME=/gpg")

    git_config=("gpg.program=gpg")
    if [[ -n "$signing_key" ]]; then
      git_config+=("user.signingkey=$signing_key")
    fi
    if [[ "$commit_gpgsign" == "true" ]]; then
      git_config+=("commit.gpgsign=true")
    fi
    if [[ "$tag_gpgsign" == "true" ]]; then
      git_config+=("tag.gpgsign=true")
    fi

    # Git reads these without writing to the container's ~/.gitconfig.
    envs+=(--env "GIT_CONFIG_COUNT=${#git_config[@]}")
    for i in "${!git_config[@]}"; do
      envs+=(
        --env "GIT_CONFIG_KEY_$i=${git_config[$i]%%=*}"
        --env "GIT_CONFIG_VALUE_$i=${git_config[$i]#*=}"
      )
    done
  fi
fi

# Global, non-secret Pi configuration. Never mount auth.json, trust.json,
# sessions, mcp-auth.json or the whole ~/.pi/agent directory.
for file in settings.json models.json AGENTS.md; do
  if [[ -f "$HOME/.pi/agent/$file" ]]; then
    mounts+=(--mount "type=bind,src=$HOME/.pi/agent/$file,dst=/global-pi/$file,ro")
  fi
done

for dir in prompts skills themes extensions; do
  if [[ -d "$HOME/.pi/agent/$dir" ]]; then
    mounts+=(--mount "type=bind,src=$HOME/.pi/agent/$dir,dst=/global-pi/$dir,ro")
  fi
done

# Credentials are seeded from a read-only host directory into a per-container
# tmpfs. Login and OAuth refreshes never write back to the host file, so a
# compromised sandbox cannot poison future sessions. Create the host auth
# directory once and copy auth.json into it if you want a single /login for all
# containers.
mounts+=(
  --mount "type=bind,src=$STATE_DIR/auth,dst=/auth-seed,ro"
  --tmpfs "/shared-auth:rw,nosuid,nodev,size=1m,mode=1777"
)

# Optional GitHub CLI token. It is a capability: any Pi container with this
# environment variable can use GitHub as that token. Prefer a fine-grained PAT.
if [[ -f "$STATE_DIR/secrets/gh_token" ]]; then
  mounts+=(--mount "type=bind,src=$STATE_DIR/secrets/gh_token,dst=/secrets/gh_token,ro")
  envs+=(--env "GH_TOKEN=$(<"$STATE_DIR/secrets/gh_token")")
fi

# Only projects that declare an MCP server get the control network and token.
# MCP_TOKEN is exported here and inherited by `podman run --env MCP_TOKEN`; its
# value is never placed in the podman argv.
if [[ "$mcp_enabled" -eq 1 ]]; then
  networks+=(--network "$MCP_NETWORK")

  if [[ "$MCP_TOKEN_AVAILABLE" -eq 1 ]]; then
    export MCP_TOKEN="$MCP_TOKEN_VALUE"
    envs+=(--env MCP_TOKEN)
  fi
fi

run_cmd=(
  podman run --rm -it \
    --name "pi-${project_name}-$$" \
    --label "pi-sandbox.project=$project_name" \
    --userns=keep-id \
    --user "$(id -u):$(id -g)" \
    --init \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --pids-limit=512 \
    --memory=4g \
    --workdir "$container_workspace" \
    --mount "type=volume,src=$home_volume,dst=/home/$USER" \
    --mount "type=bind,src=$workspace,dst=/workspace" \
    --mount "type=volume,src=$state_volume,dst=/state/pi-agent" \
    --mount "type=bind,src=$session_dir,dst=/sessions" \
    --tmpfs "/tmp:rw,nosuid,nodev" \
    "${mounts[@]}" \
    "${mirror_mounts[@]}" \
    "${envs[@]}" \
    "${networks[@]}" \
    "$PI_IMAGE" pi \
    --extension /usr/local/share/pi-sandbox/sandbox-status.ts \
    "$@"
)

if [[ "$dry_run" -eq 1 ]]; then
  # The command only contains `--env MCP_TOKEN`; the value is not in argv.
  printf '%q ' "${run_cmd[@]}"
  printf '\n'
  exit 0
fi

"${run_cmd[@]}"
